DB_NAME=voicestressai_db
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
EMAIL_HOST_USER=yourgmail@gmail.com
EMAIL_HOST_PASSWORD=your_google_app_password
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# ------------------------------------------------------------------------------
# SVARAABHAVA — MongoDB Atlas & Biometric Face Authentication Configuration
# ------------------------------------------------------------------------------
# MongoDB Atlas Connection URI (e.g. mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=svaraabhava_biometrics
MONGODB_COLLECTION=face_templates
MONGODB_ATTENDANCE_COLLECTION=attendance_records

# 32-byte URL-safe base64-encoded secret key for Fernet application-layer biometric template encryption
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BIOMETRIC_ENCRYPTION_KEY=your_base64_32byte_fernet_key_here

# ArcFace Cosine Similarity Threshold (Baseline: 0.50)
FACE_SIMILARITY_THRESHOLD=0.50

# College Geofence Coordinates & Tolerance for Attendance Punching
COLLEGE_GEOFENCE_LATITUDE=17.385044
COLLEGE_GEOFENCE_LONGITUDE=78.486671
COLLEGE_GEOFENCE_RADIUS_METERS=500.0
MAX_ALLOWED_GPS_ACCURACY_METERS=100.0

# Development Mode (True enables full 512-D vector inspection on frontend)
FACE_DEV_MODE=false
